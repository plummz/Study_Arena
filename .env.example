# Copy to .env and supply institution-controlled values. Never commit .env.
SITE_DOMAIN=study.your-school.example
APP_ORIGIN=https://study.your-school.example
DATA_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
MINOR_CONSENT_CODE=
PRIZE_POLICY_APPROVED=false
# Optional SMTP over implicit TLS, no live delivery in --demo mode.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional absolute path INSIDE the runtime; mount read-only separately.
# FCM_SERVICE_ACCOUNT=/run/secrets/firebase-service-account.json
# Optional AI Study Studio key from Google AI Studio (aistudio.google.com → Get API key).
# Server-side secret: never put it in web/ or the Android app.
# Without it the Studio runs in "local text mode": only .txt/.md/.csv/.json/code files can be
# turned into drafts; PDFs, images, audio and video stay stored but cannot be processed, and the
# Studio page says so. Word/PowerPoint/Excel files must be saved as PDF for the AI to read them.
# On Gemini's free tier Google may use submitted content to improve its products: use your own
# or synthetic material only. Real student files need a paid (billed) Gemini API project.
GEMINI_API_KEY=
# Optional model override; defaults to gemini-3.5-flash (larger free quota than gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.5-flash
# Tried once when the main model is busy (500/503) or out of quota (429); defaults to
# gemini-3.5-flash-lite, which has its own free quota.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
