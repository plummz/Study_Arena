[application]
config/name="Study Arena: Dungeon of Knowledge"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
occlusion_culling/use_occlusion_culling=true

[input]
move_forward={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":68)]}
run={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
interact={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":69)]}
jump={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":32)]}
map={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":77)]}
camera_left={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":4194319)]}
camera_right={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":4194321)]}
camera_up={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":4194320)]}
camera_down={"deadzone":0.3,"events":[Object(InputEventKey,"physical_keycode":4194322)]}

[layer_names]
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Encounter"
