xt","bytes":398,"sha256":"88ac8df60233f650d73bbc27144c5ace3ac03431e7586b6eb3e3600b0b749bf5","source":"Original Study Arena instructional notes; instructor review recommended","license":"CC BY 4.0","status":"approved","verified_by":null,"created":1789387393.705,"course":"Information Technology","subject":"Computer Science"},{"id":"notes-calculus","owner_id":null,"title":"Engineering reference · derivative rules","topic_id":"calculus","year":1,"file_type":"text","bytes":386,"sha256":"228ee76f2fdfaad3f70e13ce31e6a02cea705a767b69f05b98a0326830cb4b9b","source":"Original Study Arena instructional notes; instructor review recommended","license":"CC BY 4.0","status":"approved","verified_by":null,"created":1789387393.703,"course":"Civil Engineering","subject":"Engineering Mathematics"},{"id":"notes-algebra","owner_id":null,"title":"algebra reference notes","topic_id":"algebra","year":1,"file_type":"text","bytes":370,"sha256":"6609243dde6259ce4ecc68e014324a7c64772b2ea92ef5c700e5492caceafb4b","source":"Original Study Arena instructional notes; instructor review recommended","license":"CC BY 4.0","status":"approved","verified_by":null,"created":1789387393.699,"course":"STEM","subject":"Mathematics"}]},"/api/config":{"flags":[{"name":"rooms","enabled":1},{"name":"competition","enabled":1},{"name":"levels","enabled":0},{"name":"prizes","enabled":0}],"earning_rules":{"study":"1 XP/minute + 1 coin/5 minutes; minimum 5 minutes","reviews":"2 XP + 1 coin per due card, once/24h","quizzes":"5 XP + 2 coins per new correct-answer improvement","daily_caps":"500 XP and 100 earned coins per rolling 24h","levels":"100 XP per level; maximum level 50; solo study unlocks every level"},"support":"Contact your school guidance office or a trusted person. For immediate danger in the Philippines, call 911.","api_origin":"http://localhost:8383"},"/api/decks/starter-algebra?limit=100":{"deck":{"id":"starter-algebra","owner_id":null,"title":"Algebra foundations","topic_id":"algebra","visibility":"public","room_id":null,"status":"approved","version":1,"updated":1789387393.663,"source":"Original Study Arena instructional examples","license":"CC BY 4.0"},"cards":[{"id":"starter-algebra-0","deck_id":"starter-algebra","front":"What operation solves 3x = 12?","back":"Divide both sides by 3; x = 4.","image_id":null,"image_alt":"","fingerprint":"54b7b92dbe339a161a7ee99a75065edd40c754f49f6435cbee8d05ac748fdfc5","position":0,"due":null,"interval_days":null},{"id":"starter-algebra-1","deck_id":"starter-algebra","front":"What is the slope in y = 2x + 5?","back":"2. In y = mx + b, m is the slope.","image_id":null,"image_alt":"","fingerprint":"05dd6d2f0fd224ecb80493e76036e66ef0c0a45f2f7257188f61aafc712ba032","position":1,"due":null,"interval_days":null},{"id":"starter-algebra-2","deck_id":"starter-algebra","front":"Solve x + 7 = 10.","back":"Subtract 7 from both sides; x = 3.","image_id":null,"image_alt":"","fingerprint":"0917b6bcd06348f1f74e067f9121645be16eaddaafd38eb2fd56b20c15d7d12b","position":2,"due":null,"interval_days":null}],"total":3},"/api/quizzes/quiz-algebra":{"quiz":{"id":"quiz-algebra","owner_id":null,"title":"algebra · quick practice","topic_id":"algebra","status":"approved","duration":180,"version":1,"updated":1789387393.664,"source":"Original Study Arena instructional examples","license":"CC BY 4.0"},"questions":[{"id":"quiz-algebra-0","quiz_id":"quiz-algebra","kind":"mcq","prompt":"Solve 3x = 12.","options":["2","3","4","6"],"accepted":["4"],"explanation":"Divide both sides by 3: x = 12 ÷ 3 = 4.","topic_id":"algebra","position":1},{"id":"quiz-algebra-1","quiz_id":"quiz-algebra","kind":"boolean","prompt":"The slope of y = 2x + 5 is 5.","options":["True","False"],"accepted":["False"],"explanation":"The coefficient of x is the slope, so it is 2.","topic_id":"algebra","position":2},{"id":"quiz-algebra-2","quiz_id":"quiz-algebra","kind":"identification","prompt":"Solve x + 7 = 10. Enter x.","options":[],"accepted":["3"],"explanation":"Subtract 7 from both sides: x = 3.","topic_id":"algebra","position":3}]},"/api/materials/notes-algebra":{"material":{"id":"notes-algebra","owner_id":null,"title":"algebra reference notes","topic_id":"algebra","year":1,"file_type":"text","body":"# algebra study notes\n\nWhat operation solves 3x = 12?\nDivide both sides by 3; x = 4.\n\nWhat is the slope in y = 2x + 5?\n2. In y = mx + b, m is the slope.\n\nSolve x + 7 = 10.\nSubtract 7 from both sides; x = 3.\n\nPractice: write one example of your own, then explain each step aloud. These short original notes are starter content, not a textbook or verified course syllabus.","file_key":null,"bytes":370,"sha256":"6609243dde6259ce4ecc68e014324a7c64772b2ea92ef5c700e5492caceafb4b","source":"Original Study Arena instructional notes; instructor review recommended","license":"CC BY 4.0","status":"approved","verified_by":null,"created":1789387393.699}},"/api/decks/starter-calculus?limit=100":{"deck":{"id":"starter-calculus","owner_id":null,"title":"Engineering essentials","topic_id":"calculus","visibility":"public","room_id":null,"status":"approved","version":1,"updated":1789387393.7,"source":"Original Study Arena instructional examples","license":"CC BY 4.0"},"cards":[{"id":"starter-calculus-0","deck_id":"starter-calculus","front":"Differentiate x².","back":"2x, using the power rule.","image_id":null,"image_alt":"","fingerprint":"ce2cb71159084149d864c2490e4e1c898048ffc1b4a031259c1602413ed6b5fb","position":0,"due":null,"interval_days":null},{"id":"starter-calculus-1","deck_id":"starter-calculus","front":"What is the derivative of a constant?","back":"Zero: a constant does not change.","image_id":null,"image_alt":"","fingerprint":"f1be0ef49aa44f6ed617b4317cb96b2186bbe1ee2b0a428fee5fe48405b9451a","position":1,"due":null,"interval_days":null},{"id":"starter-calculus-2","deck_id":"starter-calculus","front":"What does a derivative measure?","back":"The instantaneous rate of change of a function.","image_id":null,"image_alt":"","fingerprint":"b0b14135e70b7753c192b7c37e40b5eb4b15b8131d843caf8edd2b762783cd25","position":2,"due":null,"interval_days":null}],"total":3},"/api/quizzes/quiz-calculus":{"quiz":{"id":"quiz-calculus","owner_id":null,"title":"calculus · quick practice","topic_id":"calculus","status":"approved","duration":180,"version":1,"updated":1789387393.7,"source":"Original Study Arena instructional examples","license":"CC BY 4.0"},"questions":[{"id":"quiz-calculus-0","quiz_id":"quiz-calculus","kind":"mcq","prompt":"What is the derivative of x²?","options":["x","2x","2","x³"],"accepted":["2x"],"explanation":"The power rule gives d(xⁿ)/dx = nxⁿ⁻¹.","topic_id":"calculus","position":1},{"id":"quiz-calculus-1","quiz_id":"quiz-calculus","kind":"boolean","prompt":"The derivative of a constant is zero.","options":["True","False"],"accepted":["True"],"explanation":"A constant has no change, so its rate of change is zero.","topic_id":"calculus","position":2},{"id":"quiz-calculus-2","quiz_id":"quiz-calculus","kind":"identification","prompt":"For f(x)=3x², find f′(2).","options":[],"accepted":["12"],"explanation":"f′(x)=6x, and 6×2=12.","topic_id":"calculus","position":3}]},"/api/materials/notes-calculus":{"material":{"id":"notes-calculus","owner_id":null,"title":"Engineering reference · derivative rules","topic_id":"calculus","year":1,"file_type":"text","body":"# calculus study notes\n\nDifferentiate x².\n2x, using the power rule.\n\nWhat is the derivative of a constant?\nZero: a constant does not change.\n\nWhat does a derivative measure?\nThe instantaneous rate of change of a function.\n\nPractice: write one example of your own, then explain each step aloud. These short original notes are starter content, not a textbook or verified course syllabus.","file_key":null,"bytes":386,"sha256":"228ee76f2fdfaad3f70e13ce31e6a02cea705a767b69f05b98a0326830cb4b9b","source":"Original Study Arena instructional notes; instructor review recommended","license":"CC BY 4.0","status":"approved","verified_by":null,"created":1789387393.703}},"/api/decks/starter-computing?limit=100":{"deck":{"id":"starter-computing","owner_id":null,"title":"A gentle start to computing","topic_id":"computing","visibility":"public","room_id":null,"status":"approved","version":1,"updated":1789387393.703,"source":"Original Study Arena instructional examples","license":"CC BY 4.0"},"cards":[{"id":"starter-computing-0","deck_id":"starter-computing","front":"What is binary 101 in decimal?","back":"5: 1×4 + 0×2 + 1×1.","image_id":null,"image_alt":"","fingerprint":"61ba6c21afd4c19e4da472f76dc741e05150012c6c7ee004fb339d95b2a1fa4c","position":0,"due":null,"interval_days":null},{"id":"starter-computing-1","deck_id":"starter-computing","front":"What is an algorithm?","back":"A finite, ordered sequence of steps for solving a problem.","image_id":null,"image_alt":"","fingerprint":"bc9a3df115f7585091194d325e0ac3a9b90516a98f80596df5fe22e5b92f5f3c","position":1,"due":null,"interval_days":null},{"id":"starter-computing-2","deck_id":"starter-computing","front":"What is the time complexity of scanning n items once?","back":"O(n), linear time.","image_id":null,"image_alt":"","fingerprint":"6109239a594a9605f687f8ba8c8d1c2d48e77b986eefd8bee02f3b43c8c796f2","position":2,"due":null,"interval_days":null}],"total":3},"/api/quizzes/quiz-computing":{"quiz":{"id":"quiz-computing","owner_id":null,"title":"computing · quick practice","topic_id":"computing","status":"approved","duration":180,"version":1,"updated":1789387393.703,"source":"Original Study Arena instructional examples","license":"CC BY 4.0"},"questions":[{"id":"quiz-computing-0","quiz_id":"quiz-computing","kind":"mcq","prompt":"Convert binary 101 to decimal.","options":["3","4","5","6"],"accepted":["5"],"explanation":"The place values are 4, 2 and 1: 4+0+1=5.","topic_id":"computing","position":1},{"id":"quiz-computing-1","quiz_id":"quiz-computing","kind":"boolean","prompt":"An algorithm is a finite sequence of steps.","options":["True","False"],"accepted":["True"],"explanation":"Algorithms specify ordered steps that terminate for their intended inputs.","topic_id":"computing","position":2},{"id":"quiz-computing-2","quiz_id":"quiz-computing","kind":"identification","prompt":"A single loop over n items has which Big-O complexity?","options":[],"accepted":["O(n)","linear"],"explanation":"Work grows proportionally with n, so the complexity is O(n).","topic_id":"computing","position":3}]},"/api/materials/notes-computing":{"material":{"id":"notes-computing","owner_id":null,"title":"computing reference notes","topic_id":"computing","year":1,"file_type":"text","body":"# computing study notes\n\nWhat is binary 101 in decimal?\n5: 1×4 + 0×2 + 1×1.\n\nWhat is an algorithm?\nA finite, ordered sequence of steps for solving a problem.\n\nWhat is the time complexity of scanning n items once?\nO(n), linear time.\n\nPractice: write one example of your own, then explain each step aloud. These short original notes are starter content, not a textbook or verified course syllabus.","file_key":null,"bytes":398,"sha256":"88ac8df60233f650d73bbc27144c5ace3ac03431e7586b6eb3e3600b0b749bf5","source":"Original Study Arena instructional notes; instructor review recommended","license":"CC BY 4.0","status":"approved","verified_by":null,"created":1789387393.705}}}